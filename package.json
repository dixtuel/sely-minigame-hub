    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.0",
    "wouter": "^3.11.0",
    "zod": "^4.1.12"
