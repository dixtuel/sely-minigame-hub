    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/global-config": "^1.5.1",
    "@vercel/speed-insights": "^2.0.0",
