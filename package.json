    "esbuild": "^0.25.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-manus-runtime": "0.0.59",
