{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/BingSiteAuth.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/google(.*).html",
      "destination": "/api/index.ts"
    },
    {
      "source": "/yandex_(.*).html",
      "destination": "/api/index.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/manus-storage/(.*)",
      "destination": "/manus-storage/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}