# Copy to .env. This file contains no credentials by default.
PORT=3000
PRIMARY_DOMAIN=

# Optional persistent remote libSQL/Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional external Redis cache. Empty uses the local SQLite leaderboard path.
REDIS_URL=

# Optional self-hosted daily jobs; generate a random value if enabling timers.
DAILY_JOB_TOKEN=

# Optional Vaka providers; deterministic local fallback works without these.
GROQ_API_KEY=
GROQ_API_KEY_2=
NVIDIA_NIM_API_KEY=
MISTRAL_API_KEY=
