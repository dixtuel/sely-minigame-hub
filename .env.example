# ==============================================================================
# SELY MiniGame Hub — Çevre Değişkenleri Şablonu (.env.example)
#
# Tüm değişkenler opsiyoneldir. Hiçbiri girilmezse proje varsayılan olarak
# bellek-içi (in-memory) deterministik tohum üretimi ve yerel skorlarla açılır.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Alan Adı & SEO (Kanonik Rota)
# ------------------------------------------------------------------------------
# Sitenin çalıştığı ana alan adı. OpenGraph kartları, sitemap.xml ve dinamik SEO
# başlıklarında tam URL üretimi için kullanılır.
# Değer: Alan adı (protokolsüz) | Örnek: sely.tr veya localhost:3000
PRIMARY_DOMAIN=sely.tr

# ------------------------------------------------------------------------------
# 2. Veritabanı Yapılandırması (Opsiyonel)
# ------------------------------------------------------------------------------
# Günlük üretilen oyun tohumlarının ve geçmişin kalıcı saklanması için gereklidir.
# Boş bırakılırsa her gün bellek-içi deterministik algoritmayla üretilir.
#
# Seçenek A: PostgreSQL (Neon Serverless veya VDS/Docker yerel Postgres 16)
DATABASE_URL=postgresql://sely_user:gizli_parola@127.0.0.1:5432/sely_minigames?sslmode=prefer

# Seçenek B: libSQL / Turso SQLite (Postgres yerine tercih edilirse)
# CONTENT_DB_PROVIDER=turso
# TURSO_URL=libsql://sely-db-dixtuel.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. Günlük Liderlik Tablosu & Redis Katmanı (Opsiyonel)
# ------------------------------------------------------------------------------
# Günün en iyi derecelerini (Zero PII / tamamen anonim takma adlarla) saklar.
# Tanımlı değilse sunucu içi MemoryStore (Map) devreye girer.
#
# Seçenek A: VDS / Docker / Kendi Sunucunuz için TCP Redis (ioredis)
# Mikoshi VDS (127.0.0.1:6380) veya standart Redis (6379) için doğrudan bağlantı dizesi:
REDIS_URL=redis://127.0.0.1:6379

# Seçenek B: Vercel Marketplace / Upstash Redis (Serverless HTTP REST)
# Vercel Serverless fonksiyonlarında TCP soket tüketmeden çalışır (Free tier: 10k komut/gün).
# Vercel Marketplace üzerinden 'Upstash for Redis' eklendiğinde otomatik tanımlanır:
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX_your_upstash_secret_token_here
# (Not: Geriye dönük uyumluluk için eski KV_REST_API_URL / TOKEN değişkenleri de okunur)

# ------------------------------------------------------------------------------
# 4. Vercel Web Analytics & Speed Insights (Opsiyonel)
# ------------------------------------------------------------------------------
# Gizlilik dostu (sıfır takip çerezi, PII içermeyen) performans ve analitik araçları.
# Değer: "true" | "false" (Varsayılan: false — açık kaynak klonlarında ağ isteği yapmaz)
VITE_ENABLE_VERCEL_ANALYTICS=false
VITE_ENABLE_VERCEL_SPEED_INSIGHTS=false

# Speed Insights örnekleme oranı: 0.0 (kapalı) ile 1.0 (tüm ziyaretler) arası.
# Hobby planın 10.000 veri noktası kotasını korumak için 0.5 (yarısı) veya 0.25 verilebilir.
VITE_VERCEL_SPEED_INSIGHTS_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# 5. Zamanlanmış Görevler & Cron Güvenliği (Opsiyonel)
# ------------------------------------------------------------------------------
# Vercel Cron Jobs (vercel.json) tarafından her gece UTC 00:05'te tetiklenen
# günlük tohum üretimi ve 90 günlük retention temizliği için Bearer yetkilendirme anahtarı:
CRON_SECRET=32_karakterli_guclu_ve_rastgele_bir_gizli_anahtar_buraya

# VDS crontab veya yerel systemd timer çağrılarında 'x-sely-cron-token' başlığıyla kullanılır:
DAILY_JOB_TOKEN=vds_crontab_icin_ozel_guvenlik_anahtari_buraya

# ------------------------------------------------------------------------------
# 6. Arama Motoru Doğrulama Kodları (Opsiyonel)
# ------------------------------------------------------------------------------
# Arama motoru panellerinde mülk doğrulamak için HTML <meta> etiketlerine basılır:
# GOOGLE_SITE_VERIFICATION=google1234567890abcdef
# BING_SITE_VERIFICATION=BING1234567890ABCDEF1234567890ABCD
# YANDEX_SITE_VERIFICATION=yandex1234567890abcdef

# ------------------------------------------------------------------------------
# 7. Google AdSense (Opsiyonel)
# ------------------------------------------------------------------------------
# Boş bırakıldığında reklam alanları sayfada tamamen gizlenir ve yer tutmaz.
# VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
# VITE_ADSENSE_RESULT_SLOT_ID=9876543210
