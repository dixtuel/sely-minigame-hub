# SELY MiniGame Hub — Environment Variables
PRIMARY_DOMAIN=sely.tr

# Database & Persistent Store (Optional, fallback to in-memory)
# VDS / Local SQLite: TURSO_DATABASE_URL=file:./data/sely.db (Zero external server, zero docker)
# Vercel Marketplace: TURSO_DATABASE_URL=libsql://[db].turso.io (Free tier: 500M reads, 10M writes/mo, no sleep)
DATABASE_URL=postgresql://user:password@localhost:5432/sely_hub
# TURSO_DATABASE_URL=file:./data/sely.db
# TURSO_AUTH_TOKEN=your-turso-token

# Vercel Global Config (Optional, instant banner/maintenance flags)
# GLOBAL_CONFIG_ID=gc_xxxxxxxxx

# Daily Leaderboard / Redis (Optional: TCP Redis on VDS, Upstash HTTP on Vercel, or Turso/Memory)
REDIS_URL=redis://127.0.0.1:6379
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Vercel Analytics & Speed Insights (true | false)
VITE_ENABLE_VERCEL_ANALYTICS=false
VITE_ENABLE_VERCEL_SPEED_INSIGHTS=false
VITE_VERCEL_SPEED_INSIGHTS_SAMPLE_RATE=1.0

# Cron Security
CRON_SECRET=your-cron-secret
DAILY_JOB_TOKEN=your-daily-token

# Search Engine Verification (Optional)
# GOOGLE_SITE_VERIFICATION=your-code
# BING_SITE_VERIFICATION=your-code
# YANDEX_SITE_VERIFICATION=your-code

# Google AdSense (Optional)
# VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# VITE_ADSENSE_RESULT_SLOT_ID=1234567890
