# SELY MiniGame Hub — Environment Variables (.env.example)

# Domain & SEO
PRIMARY_DOMAIN=sely.tr

# Database (Optional - in-memory fallback if unset)
DATABASE_URL=postgresql://user:password@localhost:5432/sely_hub
# CONTENT_DB_PROVIDER=turso
# TURSO_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Daily Leaderboard & Redis (Optional - in-memory fallback if unset)
# For VDS / Docker / VPS:
REDIS_URL=redis://127.0.0.1:6379
# For Vercel Serverless / Upstash Marketplace (Hobby plan: 10k commands/day free):
# UPSTASH_REDIS_REST_URL=https://your-upstash.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Vercel Analytics & Speed Insights (Optional, zero-cookie)
VITE_ENABLE_VERCEL_ANALYTICS=false
VITE_ENABLE_VERCEL_SPEED_INSIGHTS=false
VITE_VERCEL_SPEED_INSIGHTS_SAMPLE_RATE=1.0

# Cron Jobs
CRON_SECRET=your-cron-secret-32-chars
DAILY_JOB_TOKEN=your-daily-job-token

# Search Engine Verification (Optional)
# GOOGLE_SITE_VERIFICATION=your-token
# BING_SITE_VERIFICATION=your-token
# YANDEX_SITE_VERIFICATION=your-token

# Google AdSense (Optional - hidden if unset)
# VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXX
# VITE_ADSENSE_RESULT_SLOT_ID=1234567890
