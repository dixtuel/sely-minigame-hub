# SELY MiniGame Hub — Ortam Değişkenleri
#
# Hepsi opsiyoneldir. Hiçbirini doldurmadan yerel Rust sunucusu SQLite dosyasını,
# frontend ise deterministik yerel oyun akışını kullanır. Vercel serverless ortamında
# kalıcı libSQL/Redis tanımlı değilse skor depolaması invocation belleğiyle sınırlıdır.
# Bu dosyayı `.env` olarak kopyala ve doldur: cp .env.example .env

# ============================================================
# VERİTABANI — Günlük içerik & skor arşivi (opsiyonel)
# ============================================================
# Aktif Rust backend'inin desteklediği tek SQL biçimi libSQL/SQLite'tır.
# Standalone/VPS: bu değişken boş bırakılırsa ./data/sely.db otomatik kullanılır.
# Uzak Turso/libSQL ayarlanırsa önce o denenir; bağlantı kurulamazsa standalone yerel
# ./data/sely.db'ye düşer. Vercel'de yerel dosya kalıcı olmadığından bu fallback yoktur.
# PostgreSQL/DATABASE_URL şu an Rust backend'inde desteklenmez.
# Bulut: https://turso.tech üzerinden libSQL DB ve auth token oluştur.
# TURSO_DATABASE_URL=file:./data/sely.db
# TURSO_AUTH_TOKEN=

# VAKA LLM — opsiyonel dış yanıt sağlayıcıları; boş/başarısızsa oyun yerel motorda sürer.
# GROQ_API_KEY=
# GROQ_API_KEY_2=
# NVIDIA_NIM_API_KEY=
# MISTRAL_API_KEY=

# ============================================================
# REDIS — Liderlik tablosu önbelleği (opsiyonel)
# ============================================================
# Rust backend fred istemcisi `redis://` yerel/self-hosted ve `rediss://` TLS/bulut
# bağlantılarını destekler. Bu yalnız 24 saatlik leaderboard hızlı katmanıdır; kalıcı
# skor kaynağı libSQL/SQLite'tır. Boş bırakılırsa harici Redis gerekmez; DB ve uygulama
# içi sınırlı bellek deposu kullanılır. Kaynak Docker kurulumunda Redis isteğe bağlı
# profildir: REDIS_URL=redis://redis:6379 docker compose --profile redis up -d --build.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=rediss://user:password@managed-redis.example:6379

# ============================================================
# GÜVENLİK — Zamanlanmış görev (cron) yetkilendirmesi
# ============================================================
# Rastgele, tahmin edilemez bir değer üret: openssl rand -hex 32
# CRON_SECRET  -> Vercel Cron'un gönderdiği `Authorization: Bearer <değer>` başlığı
# DAILY_JOB_TOKEN -> VDS crontab'ının gönderdiği `x-sely-cron-token` başlığı
CRON_SECRET=
DAILY_JOB_TOKEN=

# ============================================================
# VERCEL — Global Config, Analytics, Speed Insights (opsiyonel)
# ============================================================
# Global Config (Edge Config): https://vercel.com/docs/storage/edge-config
# — deploy atmadan duyuru banner'ı / bakım modu yönetimi sağlar.
# GLOBAL_CONFIG_ID=

# true/false — hardcoded ID içermez, sıfır çerezli
VITE_ENABLE_VERCEL_ANALYTICS=false
VITE_ENABLE_VERCEL_SPEED_INSIGHTS=false
# Speed Insights örnekleme oranı (0.0–1.0), ücretsiz kotayı korumak için düşürülebilir
VITE_VERCEL_SPEED_INSIGHTS_SAMPLE_RATE=1.0

# ============================================================
# SEO — Arama motoru doğrulama kodları (opsiyonel)
# ============================================================
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# YANDEX_SITE_VERIFICATION=

# ============================================================
# REKLAM — Google AdSense (opsiyonel)
# ============================================================
# Tanımsızsa reklam bileşeni hiç render edilmez (null döner).
# VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# VITE_ADSENSE_RESULT_SLOT_ID=1234567890

# ============================================================
# GENEL
# ============================================================
# İsteğe bağlı sabit canonical host (protokol olmadan host adı).
PRIMARY_DOMAIN=
